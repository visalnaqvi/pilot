OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Optional local-only branding override. Restart `npm run dev` after changing it.
# Available values: mockpilot, aggarwal-education
LOCAL_BRAND_CLIENT_ID=
# Optional dedicated model for canonical exam-name and acronym resolution.
OPENAI_EXAM_RESOLUTION_MODEL=gpt-5.6-luna
OPENAI_TOPIC_RESOLUTION_MODEL=gpt-5.6-luna
# Dedicated model for uploaded-material analysis, generation, and verification.
OPENAI_TEST_GENERATION_MODEL=gpt-5.6-terra
# Signing secret from the OpenAI project webhook configuration.
OPENAI_WEBHOOK_SECRET=
# Server-side rollout flag. Set to false to prevent new generation jobs.
AI_TEST_GENERATION_ENABLED=true

# Neon pooled connection for application traffic and interactive transactions.
DATABASE_URL=
# Neon direct connection used only by Drizzle schema migrations.
DATABASE_URL_DIRECT=
# The existing Firebase account with this email becomes the initial administrator.
BOOTSTRAP_ADMIN_EMAIL=
# Optional Firebase UID for seeding that administrator before their first sign-in.
BOOTSTRAP_ADMIN_UID=

FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# A literal \n-delimited service-account key is accepted. FIREBASE_PRIVATE_KEY
# is also accepted as a fallback for existing Vercel configurations.
FIREBASE_ADMIN_PRIVATE_KEY=
# Optional; defaults to <project-id>.firebasestorage.app.
FIREBASE_STORAGE_BUCKET=

# Server-only SendGrid delivery. Sender values are fallbacks for config/branding.ts.
SENDGRID_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=MockPilot
# Used outside Vercel. On Vercel, the canonical production custom domain from
# VERCEL_PROJECT_PRODUCTION_URL takes precedence for links in notification emails.
APP_BASE_URL=http://localhost:3000
APP_TIME_ZONE=Asia/Kolkata
# Local-only full production endpoint used by `npm run email:poll`.
TASK_EMAIL_CRON_URL=
# Optional local poll interval; defaults to 15m.
TASK_EMAIL_POLL_INTERVAL=15m
# Use a random value of at least 16 characters in Vercel.
CRON_SECRET=

# Server-only HMAC secret for short-lived attendance QR links. Use at least
# 32 random bytes and never expose this value through NEXT_PUBLIC_* variables.
QR_ATTENDANCE_SECRET=
