[debug] [2026-07-30T11:03:06.056Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/mock-test-app-b659d/rulesets {"name":"projects/mock-test-app-b659d/rulesets/068bc40e-7c20-4fd9-a1c4-e09f05e135cb","source":{"files":[{"content":"rules_version = '2';\n\nservice firebase.storage {\n  match /b/{bucket}/o {\n    function signedIn() { return request.auth != null; }\n    function canCreateTests() {\n      return signedIn() && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['admin', 'organisation'];\n    }\n    function isOrganisation() {\n      return signedIn() && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'organisation';\n    }\n    function isAdmin() {\n      return signedIn() && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';\n    }\n    function isAcceptedTeacher(organisationId) {\n      return signedIn()\n        && firestore.exists(/databases/(default)/documents/organisationInvites/$(organisationId + '_' + request.auth.uid))\n        && firestore.get(/databases/(default)/documents/organisationInvites/$(organisationId + '_' + request.auth.uid)).data.status == 'accepted'\n        && firestore.get(/databases/(default)/documents/organisationInvites/$(organisationId + '_' + request.auth.uid)).data.memberRole == 'teacher';\n    }\n    function canManageTask(task) {\n      return (isOrganisation() && task.organisationId == request.auth.uid)\n        || (task.createdBy == request.auth.uid && isAcceptedTeacher(task.organisationId));\n    }\n    function canReadTask(taskId) {\n      let task = firestore.get(/databases/(default)/documents/tasks/$(taskId)).data;\n      return signedIn() && (isAdmin() || canManageTask(task)\n        || isAcceptedTeacher(task.organisationId)\n        || request.auth.uid in task.assignedUserIds);\n    }\n    function taskUserWindowOpen(taskId) {\n      let task = firestore.get(/databases/(default)/documents/tasks/$(taskId)).data;\n      return (!('startAt' in task) || task.startAt == null || task.startAt <= request.time)\n        && (!('endAt' in task) || task.endAt == null || task.endAt > request.time);\n    }\n\n    match /question-images/{userId}/{allPaths=**} {\n      allow read: if signedIn();\n      allow write: if canCreateTests() && request.auth.uid == userId && request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/.*');\n    }\n\n    match /question-images/{organisationId}/{userId}/{allPaths=**} {\n      allow read: if signedIn();\n      allow write: if request.auth.uid == userId\n        && ((isOrganisation() && request.auth.uid == organisationId) || isAcceptedTeacher(organisationId))\n        && request.resource.size < 5 * 1024 * 1024\n        && request.resource.contentType.matches('image/.*');\n    }\n\n    match /test-generation-sources/{organisationId}/{jobId}/{allPaths=**} {\n      allow read: if isAdmin() || (isOrganisation() && request.auth.uid == organisationId\n        && firestore.get(/databases/(default)/documents/testGenerationJobs/$(jobId)).data.ownerId == request.auth.uid);\n      allow create: if isOrganisation()\n        && request.auth.uid == organisationId\n        && firestore.get(/databases/(default)/documents/testGenerationJobs/$(jobId)).data.ownerId == request.auth.uid\n        && request.resource.size <= 20 * 1024 * 1024\n        && request.resource.contentType.matches('(application/pdf|application/msword|application/vnd.openxmlformats-officedocument.wordprocessingml.document|application/rtf|text/rtf|application/vnd.oasis.opendocument.text|application/octet-stream|text/plain|text/markdown|image/png|image/jpeg|image/webp|image/gif)');\n      allow update: if false;\n      allow delete: if isAdmin() || (isOrganisation() && request.auth.uid == organisationId);\n    }\n\n    match /organisation-profiles/{organisationId}/{imageName} {\n      allow read: if signedIn();\n      allow create, update: if isOrganisation()\n        && request.auth.uid == organisationId\n        && request.resource.size <= 5 * 1024 * 1024\n        && request.resource.contentType.matches('image/.*');\n      allow delete: if isOrganisation() && request.auth.uid == organisationId;\n    }\n\n    match /task-attachments/{organisationId}/{taskId}/{allPaths=**} {\n      allow read: if canReadTask(taskId);\n      allow create: if ((isOrganisation() && request.auth.uid == organisationId) || isAcceptedTeacher(organisationId))\n        && request.resource.size <= 20 * 1024 * 1024;\n      allow delete: if canManageTask(firestore.get(/databases/(default)/documents/tasks/$(taskId)).data);\n      allow update: if false;\n    }\n\n    match /task-submissions/{organisationId}/{taskId}/{userId}/{allPaths=**} {\n      allow read: if signedIn()\n        && (isAdmin() || canManageTask(firestore.get(/databases/(default)/documents/tasks/$(taskId)).data)\n          || (request.auth.uid == userId\n            && request.auth.uid in firestore.get(/databases/(default)/documents/tasks/$(taskId)).data.assignedUserIds));\n      allow create: if signedIn()\n        && request.auth.uid == userId\n        && firestore.get(/databases/(default)/documents/tasks/$(taskId)).data.organisationId == organisationId\n        && firestore.get(/databases/(default)/documents/tasks/$(taskId)).data.taskType == 'submission'\n        && firestore.get(/databases/(default)/documents/tasks/$(taskId)).data.isClosed == false\n        && taskUserWindowOpen(taskId)\n        && request.auth.uid in firestore.get(/databases/(default)/documents/tasks/$(taskId)).data.assignedUserIds\n        && request.resource.size <= 20 * 1024 * 1024;\n      allow delete: if canManageTask(firestore.get(/databases/(default)/documents/tasks/$(taskId)).data)\n        || (signedIn()\n          && request.auth.uid == userId\n          && !firestore.exists(/databases/(default)/documents/tasks/$(taskId)/submissions/$(userId)));\n      allow update: if false;\n    }\n\n  }\n}\n","name":"storage.rules"}]},"createTime":"2026-07-30T11:03:06.295663Z","metadata":{"services":["firebase.storage"]}}
