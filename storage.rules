rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function canCreateTests() {
      return signedIn() && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['admin', 'organisation'];
    }
    function isOrganisation() {
      return signedIn() && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'organisation';
    }
    function isAdmin() {
      return signedIn() && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function isAcceptedTeacher(organisationId) {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/organisationInvites/$(organisationId + '_' + request.auth.uid))
        && firestore.get(/databases/(default)/documents/organisationInvites/$(organisationId + '_' + request.auth.uid)).data.status == 'accepted'
        && firestore.get(/databases/(default)/documents/organisationInvites/$(organisationId + '_' + request.auth.uid)).data.memberRole == 'teacher';
    }
    function canManageTask(task) {
      return (isOrganisation() && task.organisationId == request.auth.uid)
        || (task.createdBy == request.auth.uid && isAcceptedTeacher(task.organisationId));
    }
    function canReadTask(taskId) {
      let task = firestore.get(/databases/(default)/documents/tasks/$(taskId)).data;
      return signedIn() && (isAdmin() || canManageTask(task)
        || isAcceptedTeacher(task.organisationId)
        || request.auth.uid in task.assignedUserIds);
    }
    function taskUserWindowOpen(taskId) {
      let task = firestore.get(/databases/(default)/documents/tasks/$(taskId)).data;
      return (!('startAt' in task) || task.startAt == null || task.startAt <= request.time)
        && (!('endAt' in task) || task.endAt == null || task.endAt > request.time);
    }

    match /question-images/{userId}/{allPaths=**} {
      allow read: if signedIn();
      allow write: if canCreateTests() && request.auth.uid == userId && request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
    }

    match /question-images/{organisationId}/{userId}/{allPaths=**} {
      allow read: if signedIn();
      allow write: if request.auth.uid == userId
        && ((isOrganisation() && request.auth.uid == organisationId) || isAcceptedTeacher(organisationId))
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /test-generation-sources/{organisationId}/{jobId}/{allPaths=**} {
      allow read: if isAdmin() || (isOrganisation() && request.auth.uid == organisationId
        && firestore.get(/databases/(default)/documents/testGenerationJobs/$(jobId)).data.ownerId == request.auth.uid);
      allow create: if isOrganisation()
        && request.auth.uid == organisationId
        && firestore.get(/databases/(default)/documents/testGenerationJobs/$(jobId)).data.ownerId == request.auth.uid
        && request.resource.size <= 20 * 1024 * 1024
        && request.resource.contentType.matches('(application/pdf|application/msword|application/vnd.openxmlformats-officedocument.wordprocessingml.document|application/rtf|text/rtf|application/vnd.oasis.opendocument.text|application/octet-stream|text/plain|text/markdown|image/png|image/jpeg|image/webp|image/gif)');
      allow update: if false;
      allow delete: if isAdmin() || (isOrganisation() && request.auth.uid == organisationId);
    }

    match /organisation-profiles/{organisationId}/{imageName} {
      allow read: if signedIn();
      allow create, update: if isOrganisation()
        && request.auth.uid == organisationId
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isOrganisation() && request.auth.uid == organisationId;
    }

    match /task-attachments/{organisationId}/{taskId}/{allPaths=**} {
      allow read: if canReadTask(taskId);
      allow create: if ((isOrganisation() && request.auth.uid == organisationId) || isAcceptedTeacher(organisationId))
        && request.resource.size <= 20 * 1024 * 1024;
      allow delete: if canManageTask(firestore.get(/databases/(default)/documents/tasks/$(taskId)).data);
      allow update: if false;
    }

    match /task-submissions/{organisationId}/{taskId}/{userId}/{allPaths=**} {
      allow read: if signedIn()
        && (isAdmin() || canManageTask(firestore.get(/databases/(default)/documents/tasks/$(taskId)).data)
          || isAcceptedTeacher(firestore.get(/databases/(default)/documents/tasks/$(taskId)).data.organisationId)
          || (request.auth.uid == userId
            && request.auth.uid in firestore.get(/databases/(default)/documents/tasks/$(taskId)).data.assignedUserIds));
      allow create: if signedIn()
        && request.auth.uid == userId
        && firestore.get(/databases/(default)/documents/tasks/$(taskId)).data.organisationId == organisationId
        && firestore.get(/databases/(default)/documents/tasks/$(taskId)).data.taskType == 'submission'
        && firestore.get(/databases/(default)/documents/tasks/$(taskId)).data.isClosed == false
        && taskUserWindowOpen(taskId)
        && request.auth.uid in firestore.get(/databases/(default)/documents/tasks/$(taskId)).data.assignedUserIds
        && request.resource.size <= 20 * 1024 * 1024;
      allow delete: if canManageTask(firestore.get(/databases/(default)/documents/tasks/$(taskId)).data)
        || (signedIn()
          && request.auth.uid == userId
          && !firestore.exists(/databases/(default)/documents/tasks/$(taskId)/submissions/$(userId)));
      allow update: if false;
    }

  }
}
