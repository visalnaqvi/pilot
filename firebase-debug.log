[debug] [2026-07-30T11:03:09.869Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/mock-test-app-b659d/rulesets {"name":"projects/mock-test-app-b659d/rulesets/8fafd6b4-6b52-4331-b9e0-82b08f549e1c","source":{"files":[{"content":"rules_version = '2';\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    function signedIn() { return request.auth != null; }\n    function isAdmin() { return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'; }\n    function isOrganisation() { return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'organisation'; }\n    function canCreateTests() { return isAdmin() || isOrganisation(); }\n    function canManageTaskData(task) {\n      return isOrganisation() && task.organisationId == request.auth.uid\n        || (signedIn() && task.createdBy == request.auth.uid\n          && isAcceptedTeacher(task.organisationId, request.auth.uid));\n    }\n    function canViewTaskData(task) {\n      return signedIn() && isAcceptedTeacher(task.organisationId, request.auth.uid);\n    }\n    function canAccessTask(taskId) {\n      let task = get(/databases/$(database)/documents/tasks/$(taskId)).data;\n      return signedIn() && (isAdmin() || canManageTaskData(task)\n        || canViewTaskData(task)\n        || request.auth.uid in task.assignedUserIds);\n    }\n    function taskUserWindowOpen(taskId) {\n      let task = get(/databases/$(database)/documents/tasks/$(taskId)).data;\n      return (!('startAt' in task) || task.startAt == null || task.startAt <= request.time)\n        && (!('endAt' in task) || task.endAt == null || task.endAt > request.time);\n    }\n    function hasExam(data) { return data.exam is string && data.exam.size() > 0 && data.examId is string && data.examId.size() > 0; }\n    function hasCategory(data) { return data.category is string && data.category.size() > 0 && data.categoryId is string && data.categoryId.size() > 0; }\n    function hasNoAnswerKey(data) {\n      return !('correctAnswer' in data) && !('explanation' in data)\n        && !('modelAnswer' in data) && !('rubric' in data)\n        && !('answerOrigin' in data) && !('sourceReferences' in data);\n    }\n    function organisationInvitePath(organisationId, userId) {\n      let inviteId = organisationId + '_' + userId;\n      return /databases/$(database)/documents/organisationInvites/$(inviteId);\n    }\n    function isAcceptedStudent(organisationId, userId) {\n      return exists(organisationInvitePath(organisationId, userId))\n        && get(organisationInvitePath(organisationId, userId)).data.status == 'accepted'\n        && (!('memberRole' in get(organisationInvitePath(organisationId, userId)).data)\n          || get(organisationInvitePath(organisationId, userId)).data.memberRole == 'student');\n    }\n    function isAcceptedTeacher(organisationId, userId) {\n      return exists(organisationInvitePath(organisationId, userId))\n        && get(organisationInvitePath(organisationId, userId)).data.status == 'accepted'\n        && get(organisationInvitePath(organisationId, userId)).data.memberRole == 'teacher';\n    }\n    function testAssignmentPath(assignmentBatchId, userId) {\n      let assignmentId = assignmentBatchId + '_' + userId;\n      return /databases/$(database)/documents/testAssignments/$(assignmentId);\n    }\n    function belongsToOrganisation(organisationId) {\n      return isOrganisation() && organisationId == request.auth.uid\n        || (signedIn() && exists(organisationInvitePath(organisationId, request.auth.uid))\n          && get(organisationInvitePath(organisationId, request.auth.uid)).data.status == 'accepted');\n    }\n    function canReadTestById(testId) {\n      let test = get(/databases/$(database)/documents/tests/$(testId)).data;\n      return signedIn() && ((test.deletedAt != null && (isAdmin() || canManageTest(testId)))\n        || (test.deletedAt == null && (isAdmin() || test.visibility == 'public'\n          || (test.visibility == 'private' && belongsToOrganisation(test.organisationId))\n          || (test.visibility == 'assigned' && canManageTest(testId)))));\n    }\n    function canListTest() {\n      let test = resource.data;\n      return signedIn() && ((test.deletedAt != null && (isAdmin()\n          || (test.createdBy == request.auth.uid\n            && (isOrganisation() || isAcceptedTeacher(test.organisationId, request.auth.uid)))))\n        || (test.deletedAt == null && (isAdmin() || test.visibility == 'public'\n          || (test.visibility == 'private' && belongsToOrganisation(test.organisationId))\n          || (test.visibility == 'assigned'\n            && ((test.createdBy == request.auth.uid && isOrganisation())\n              || isAcceptedTeacher(test.organisationId, request.auth.uid))))));\n    }\n    function canManageTest(testId) {\n      let test = get(/databases/$(database)/documents/tests/$(testId)).data;\n      return isAdmin() || (test.createdBy == request.auth.uid\n        && (isOrganisation() || isAcceptedTeacher(test.organisationId, request.auth.uid)));\n    }\n    function canCreateMembership(testId) {\n      let test = getAfter(/databases/$(database)/documents/tests/$(testId)).data;\n      return isAdmin() || (test.createdBy == request.auth.uid\n        && (isOrganisation() || isAcceptedTeacher(test.organisationId, request.auth.uid)));\n    }\n    function canReadQuestion() {\n      return signedIn() && (isAdmin() || resource.data.visibility == 'public' || (resource.data.visibility == 'private' && belongsToOrganisation(resource.data.organisationId)));\n    }\n    function canManageQuestion() {\n      return isAdmin() || (resource.data.createdBy == request.auth.uid\n        && (isOrganisation() || isAcceptedTeacher(resource.data.organisationId, request.auth.uid)));\n    }\n    function canCreateInstituteContent(data) {\n      return isAdmin() || (data.createdBy == request.auth.uid\n        && (isOrganisation() || isAcceptedTeacher(data.organisationId, request.auth.uid)));\n    }\n    function validTestAccessMode(data) {\n      return (data.visibility == 'public' && canCreateTests())\n        || (data.visibility in ['private', 'assigned']\n          && ((isOrganisation() && data.organisationId == request.auth.uid)\n            || isAcceptedTeacher(data.organisationId, request.auth.uid)));\n    }\n    function canAssignTest(testId) {\n      return canManageTest(testId)\n        && get(/databases/$(database)/documents/tests/$(testId)).data.deletedAt == null\n        && get(/databases/$(database)/documents/tests/$(testId)).data.visibility == 'assigned';\n    }\n    function assignmentSubmissionWindowOpen(testId, assignmentBatchId, userId) {\n      let assignment = testAssignmentPath(assignmentBatchId, userId);\n      return exists(assignment)\n        && get(assignment).data.testId == testId\n        && get(assignment).data.assignmentBatchId == assignmentBatchId\n        && ((!('startAt' in get(assignment).data) || get(assignment).data.startAt <= request.time)\n        && get(assignment).data.deadline + duration.value(1, 'm') >= request.time);\n    }\n    function canOpenTest(testId) {\n      let test = get(/databases/$(database)/documents/tests/$(testId)).data;\n      return isAdmin() || canManageTest(testId)\n        || test.visibility != 'assigned';\n    }\n    function teacherOwnsAssignment(assignmentBatchId) {\n      let assignment = get(/databases/$(database)/documents/assignmentBatches/$(assignmentBatchId)).data;\n      return signedIn() && assignment.assignedBy == request.auth.uid\n        && isAcceptedTeacher(assignment.organisationId, request.auth.uid);\n    }\n    function teacherCanViewAssignment(assignmentBatchId) {\n      let assignment = get(/databases/$(database)/documents/assignmentBatches/$(assignmentBatchId)).data;\n      return signedIn() && isAcceptedTeacher(assignment.organisationId, request.auth.uid);\n    }\n    function validPrivateSubmission(testId, data) {\n      let test = get(/databases/$(database)/documents/tests/$(testId)).data;\n      return test.visibility == 'private' && belongsToOrganisation(test.organisationId)\n        && data.testVisibility == 'private' && data.attemptNumber is int\n        && data.attemptNumber > 0;\n    }\n    function validAssignedSubmission(testId, submissionId, data) {\n      let assignment = testAssignmentPath(data.assignmentBatchId, request.auth.uid);\n      return get(/databases/$(database)/documents/tests/$(testId)).data.visibility == 'assigned'\n        && data.assignmentBatchId is string\n        && assignmentSubmissionWindowOpen(testId, data.assignmentBatchId, request.auth.uid)\n        && data.testVisibility == 'assigned' && data.attemptNumber is int\n        && data.assignmentBatchId == get(assignment).data.assignmentBatchId\n        && data.attemptNumber == get(assignment).data.attemptsUsed + 1\n        && data.attemptNumber <= get(assignment).data.maxAttempts\n        && getAfter(assignment).data.attemptsUsed == data.attemptNumber\n        && submissionId == testId + '_' + request.auth.uid + '_' + data.assignmentBatchId + '_' + string(data.attemptNumber);\n    }\n\n    match /users/{userId} {\n      allow get: if signedIn() && (request.auth.uid == userId || isAdmin() || isOrganisation()\n        || resource.data.role == 'organisation'\n        || exists(organisationInvitePath(userId, request.auth.uid)));\n      allow list: if isAdmin() || isOrganisation() || (signedIn() && resource.data.role == 'organisation');\n      allow create: if signedIn() && request.auth.uid == userId && request.resource.data.uid == request.auth.uid && request.resource.data.role == 'user';\n      allow update: if (isAdmin() && request.resource.data.uid == resource.data.uid && request.resource.data.role in ['user', 'organisation'])\n        || (isOrganisation()\n          && request.auth.uid == userId\n          && request.resource.data.uid == resource.data.uid\n          && request.resource.data.email == resource.data.email\n          && request.resource.data.role == resource.data.role\n          && request.resource.data.name is string\n          && request.resource.data.name.size() > 0\n          && request.resource.data.name.size() <= 120\n          && (!('profilePhotoUrl' in request.resource.data) || (request.resource.data.profilePhotoUrl is string && request.resource.data.profilePhotoUrl.size() <= 2000))\n          && (!('logoUrl' in request.resource.data) || (request.resource.data.logoUrl is string && request.resource.data.logoUrl.size() <= 2000))\n          && (!('address' in request.resource.data) || (request.resource.data.address is string && request.resource.data.address.size() <= 500))\n          && (!('contactNumbers' in request.resource.data) || (request.resource.data.contactNumbers is list && request.resource.data.contactNumbers.size() <= 6))\n          && (!('googleMapsUrl' in request.resource.data) || (request.resource.data.googleMapsUrl is string && request.resource.data.googleMapsUrl.size() <= 2000))\n          && (!('instagramUrl' in request.resource.data) || (request.resource.data.instagramUrl is string && request.resource.data.instagramUrl.size() <= 2000))\n          && (!('facebookUrl' in request.resource.data) || (request.resource.data.facebookUrl is string && request.resource.data.facebookUrl.size() <= 2000))\n          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\n            'name', 'profilePhotoUrl', 'logoUrl', 'address', 'contactNumbers',\n            'googleMapsUrl', 'instagramUrl', 'facebookUrl', 'profileUpdatedAt'\n          ]));\n      allow delete: if false;\n    }\n\n    match /organisationInvites/{inviteId} {\n      allow get, list: if signedIn() && (resource.data.organisationId == request.auth.uid || resource.data.userId == request.auth.uid || isAdmin()\n        || isAcceptedTeacher(resource.data.organisationId, request.auth.uid));\n      allow create: if (isOrganisation()\n          && reques