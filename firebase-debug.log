roupId)).data.organisationId, request.auth.uid);\n        allow create: if isOrganisation() && get(/databases/$(database)/documents/organisationGroups/$(groupId)).data.organisationId == request.auth.uid && request.resource.data.userId == memberId && isAcceptedStudent(request.auth.uid, memberId);\n        allow update: if false;\n        allow delete: if isOrganisation() && get(/databases/$(database)/documents/organisationGroups/$(groupId)).data.organisationId == request.auth.uid;\n      }\n    }\n\n    match /tasks/{taskId} {\n      allow get, list: if signedIn() && (isAdmin() || canManageTaskData(resource.data)\n        || canViewTaskData(resource.data)\n        || request.auth.uid in resource.data.assignedUserIds);\n      allow create: if false;\n      allow update: if signedIn()\n        && ((canManageTaskData(resource.data))\n          || request.auth.uid in resource.data.assignedUserIds)\n        && request.resource.data.organisationId == resource.data.organisationId\n        && request.resource.data.createdBy == resource.data.createdBy\n        && request.resource.data.title == resource.data.title\n        && request.resource.data.description == resource.data.description\n        && request.resource.data.assignedUserIds == resource.data.assignedUserIds\n        && request.resource.data.assignedUsers == resource.data.assignedUsers\n        && request.resource.data.assignedGroupIds == resource.data.assignedGroupIds\n        && request.resource.data.audienceNames == resource.data.audienceNames\n        && (((canManageTaskData(resource.data) || request.resource.data.lastStatusUserId == request.auth.uid)\n            && (canManageTaskData(resource.data) || taskUserWindowOpen(taskId))\n            && request.resource.data.lastStatusUserId in resource.data.assignedUserIds\n            && request.resource.data.lastStatusUpdatedBy == request.auth.uid\n            && request.resource.data.lastStatus in ['todo', 'in_progress', 'done', 'closed']\n            && (request.r