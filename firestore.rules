rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'; }
    function isOrganisation() { return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'organisation'; }
    function canCreateTests() { return isAdmin() || isOrganisation(); }
    function canManageTaskData(task) {
      return isOrganisation() && task.organisationId == request.auth.uid
        || (signedIn() && task.createdBy == request.auth.uid
          && isAcceptedTeacher(task.organisationId, request.auth.uid));
    }
    function canViewTaskData(task) {
      return signedIn() && isAcceptedTeacher(task.organisationId, request.auth.uid);
    }
    function canAccessTask(taskId) {
      let task = get(/databases/$(database)/documents/tasks/$(taskId)).data;
      return signedIn() && (isAdmin() || canManageTaskData(task)
        || canViewTaskData(task)
        || request.auth.uid in task.assignedUserIds);
    }
    function taskUserWindowOpen(taskId) {
      let task = get(/databases/$(database)/documents/tasks/$(taskId)).data;
      return (!('startAt' in task) || task.startAt == null || task.startAt <= request.time)
        && (!('endAt' in task) || task.endAt == null || task.endAt > request.time);
    }
    function hasExam(data) { return data.exam is string && data.exam.size() > 0 && data.examId is string && data.examId.size() > 0; }
    function hasCategory(data) { return data.category is string && data.category.size() > 0 && data.categoryId is string && data.categoryId.size() > 0; }
    function hasNoAnswerKey(data) {
      return !('correctAnswer' in data) && !('explanation' in data)
        && !('modelAnswer' in data) && !('rubric' in data)
        && !('answerOrigin' in data) && !('sourceReferences' in data);
    }
    function organisationInvitePath(organisationId, userId) {
      let inviteId = organisationId + '_' + userId;
      return /databases/$(database)/documents/organisationInvites/$(inviteId);
    }
    function isAcceptedStudent(organisationId, userId) {
      return exists(organisationInvitePath(organisationId, userId))
        && get(organisationInvitePath(organisationId, userId)).data.status == 'accepted'
        && (!('memberRole' in get(organisationInvitePath(organisationId, userId)).data)
          || get(organisationInvitePath(organisationId, userId)).data.memberRole == 'student');
    }
    function isAcceptedTeacher(organisationId, userId) {
      return exists(organisationInvitePath(organisationId, userId))
        && get(organisationInvitePath(organisationId, userId)).data.status == 'accepted'
        && get(organisationInvitePath(organisationId, userId)).data.memberRole == 'teacher';
    }
    function testAssignmentPath(assignmentBatchId, userId) {
      let assignmentId = assignmentBatchId + '_' + userId;
      return /databases/$(database)/documents/testAssignments/$(assignmentId);
    }
    function belongsToOrganisation(organisationId) {
      return isOrganisation() && organisationId == request.auth.uid
        || (signedIn() && exists(organisationInvitePath(organisationId, request.auth.uid))
          && get(organisationInvitePath(organisationId, request.auth.uid)).data.status == 'accepted');
    }
    function canReadTestById(testId) {
      let test = get(/databases/$(database)/documents/tests/$(testId)).data;
      return signedIn() && ((test.deletedAt != null && (isAdmin() || canManageTest(testId)))
        || (test.deletedAt == null && (isAdmin() || test.visibility == 'public'
          || (test.visibility == 'private' && belongsToOrganisation(test.organisationId))
          || (test.visibility == 'assigned' && canManageTest(testId)))));
    }
    function canListTest() {
      let test = resource.data;
      return signedIn() && ((test.deletedAt != null && (isAdmin()
          || (test.createdBy == request.auth.uid
            && (isOrganisation() || isAcceptedTeacher(test.organisationId, request.auth.uid)))))
        || (test.deletedAt == null && (isAdmin() || test.visibility == 'public'
          || (test.visibility == 'private' && belongsToOrganisation(test.organisationId))
          || (test.visibility == 'assigned'
            && ((test.createdBy == request.auth.uid && isOrganisation())
              || isAcceptedTeacher(test.organisationId, request.auth.uid))))));
    }
    function canManageTest(testId) {
      let test = get(/databases/$(database)/documents/tests/$(testId)).data;
      return isAdmin() || (test.createdBy == request.auth.uid
        && (isOrganisation() || isAcceptedTeacher(test.organisationId, request.auth.uid)));
    }
    function canCreateMembership(testId) {
      let test = getAfter(/databases/$(database)/documents/tests/$(testId)).data;
      return isAdmin() || (test.createdBy == request.auth.uid
        && (isOrganisation() || isAcceptedTeacher(test.organisationId, request.auth.uid)));
    }
    function canReadQuestion() {
      return signedIn() && (isAdmin() || resource.data.visibility == 'public' || (resource.data.visibility == 'private' && belongsToOrganisation(resource.data.organisationId)));
    }
    function canManageQuestion() {
      return isAdmin() || (resource.data.createdBy == request.auth.uid
        && (isOrganisation() || isAcceptedTeacher(resource.data.organisationId, request.auth.uid)));
    }
    function canCreateInstituteContent(data) {
      return isAdmin() || (data.createdBy == request.auth.uid
        && (isOrganisation() || isAcceptedTeacher(data.organisationId, request.auth.uid)));
    }
    function validTestAccessMode(data) {
      return (data.visibility == 'public' && canCreateTests())
        || (data.visibility in ['private', 'assigned']
          && ((isOrganisation() && data.organisationId == request.auth.uid)
            || isAcceptedTeacher(data.organisationId, request.auth.uid)));
    }
    function canAssignTest(testId) {
      return canManageTest(testId)
        && get(/databases/$(database)/documents/tests/$(testId)).data.deletedAt == null
        && get(/databases/$(database)/documents/tests/$(testId)).data.visibility == 'assigned';
    }
    function assignmentSubmissionWindowOpen(testId, assignmentBatchId, userId) {
      let assignment = testAssignmentPath(assignmentBatchId, userId);
      return exists(assignment)
        && get(assignment).data.testId == testId
        && get(assignment).data.assignmentBatchId == assignmentBatchId
        && ((!('startAt' in get(assignment).data) || get(assignment).data.startAt <= request.time)
        && get(assignment).data.deadline + duration.value(1, 'm') >= request.time);
    }
    function canOpenTest(testId) {
      let test = get(/databases/$(database)/documents/tests/$(testId)).data;
      return isAdmin() || canManageTest(testId)
        || test.visibility != 'assigned';
    }
    function teacherCanViewAssignment(assignmentBatchId) {
      let assignment = get(/databases/$(database)/documents/assignmentBatches/$(assignmentBatchId)).data;
      return signedIn() && isAcceptedTeacher(assignment.organisationId, request.auth.uid);
    }
    function validPrivateSubmission(testId, data) {
      let test = get(/databases/$(database)/documents/tests/$(testId)).data;
      return test.visibility == 'private' && belongsToOrganisation(test.organisationId)
        && data.testVisibility == 'private' && data.attemptNumber is int
        && data.attemptNumber > 0;
    }
    function validAssignedSubmission(testId, submissionId, data) {
      let assignment = testAssignmentPath(data.assignmentBatchId, request.auth.uid);
      return get(/databases/$(database)/documents/tests/$(testId)).data.visibility == 'assigned'
        && data.assignmentBatchId is string
        && assignmentSubmissionWindowOpen(testId, data.assignmentBatchId, request.auth.uid)
        && data.testVisibility == 'assigned' && data.attemptNumber is int
        && data.assignmentBatchId == get(assignment).data.assignmentBatchId
        && data.attemptNumber == get(assignment).data.attemptsUsed + 1
        && data.attemptNumber <= get(assignment).data.maxAttempts
        && getAfter(assignment).data.attemptsUsed == data.attemptNumber
        && submissionId == testId + '_' + request.auth.uid + '_' + data.assignmentBatchId + '_' + string(data.attemptNumber);
    }

    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin() || isOrganisation()
        || resource.data.role == 'organisation'
        || exists(organisationInvitePath(userId, request.auth.uid)));
      allow list: if isAdmin() || isOrganisation() || (signedIn() && resource.data.role == 'organisation');
      allow create: if signedIn() && request.auth.uid == userId && request.resource.data.uid == request.auth.uid && request.resource.data.role == 'user';
      allow update: if (isAdmin() && request.resource.data.uid == resource.data.uid && request.resource.data.role in ['user', 'organisation'])
        || (isOrganisation()
          && request.auth.uid == userId
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.email == resource.data.email
          && request.resource.data.role == resource.data.role
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 120
          && (!('profilePhotoUrl' in request.resource.data) || (request.resource.data.profilePhotoUrl is string && request.resource.data.profilePhotoUrl.size() <= 2000))
          && (!('logoUrl' in request.resource.data) || (request.resource.data.logoUrl is string && request.resource.data.logoUrl.size() <= 2000))
          && (!('address' in request.resource.data) || (request.resource.data.address is string && request.resource.data.address.size() <= 500))
          && (!('contactNumbers' in request.resource.data) || (request.resource.data.contactNumbers is list && request.resource.data.contactNumbers.size() <= 6))
          && (!('googleMapsUrl' in request.resource.data) || (request.resource.data.googleMapsUrl is string && request.resource.data.googleMapsUrl.size() <= 2000))
          && (!('instagramUrl' in request.resource.data) || (request.resource.data.instagramUrl is string && request.resource.data.instagramUrl.size() <= 2000))
          && (!('facebookUrl' in request.resource.data) || (request.resource.data.facebookUrl is string && request.resource.data.facebookUrl.size() <= 2000))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'profilePhotoUrl', 'logoUrl', 'address', 'contactNumbers',
            'googleMapsUrl', 'instagramUrl', 'facebookUrl', 'profileUpdatedAt'
          ]));
      allow delete: if false;
    }

    match /organisationInvites/{inviteId} {
      allow get, list: if signedIn() && (resource.data.organisationId == request.auth.uid || resource.data.userId == request.auth.uid || isAdmin()
        || isAcceptedTeacher(resource.data.organisationId, request.auth.uid));
      allow create: if (isOrganisation()
          && request.resource.data.organisationId == request.auth.uid
          && request.resource.data.organisationEmail == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email
          && request.resource.data.userId != request.auth.uid
          && request.resource.data.userEmail == get(/databases/$(database)/documents/users/$(request.resource.data.userId)).data.email
          && get(/databases/$(database)/documents/users/$(request.resource.data.userId)).data.role == 'user'
          && request.resource.data.initiatedBy == 'organisation'
          && request.resource.data.status == 'pending')
        || (signedIn()
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'user'
          && inviteId == request.resource.data.organisationId + '_' + request.auth.uid
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.userEmail == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email
          && request.resource.data.organisationId != request.auth.uid
          && request.resource.data.organisationEmail == get(/databases/$(database)/documents/users/$(request.resource.data.organisationId)).data.email
          && get(/databases/$(database)/documents/users/$(request.resource.data.organisationId)).data.role == 'organisation'
          && request.resource.data.initiatedBy == 'user'
          && request.resource.data.status == 'pending');
      allow update: if (signedIn()
          && resource.data.userId == request.auth.uid
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'user'
          && resource.data.status == 'pending'
          && (!('initiatedBy' in resource.data) || resource.data.initiatedBy == 'organisation')
          && request.resource.data.status in ['accepted', 'declined']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt']))
        || (isOrganisation()
          && resource.data.organisationId == request.auth.uid
          && resource.data.initiatedBy == 'user'
          && resource.data.status == 'pending'
          && request.resource.data.status in ['accepted', 'declined']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt']))
        || (signedIn()
          && resource.data.userId == request.auth.uid
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'user'
          && resource.data.status == 'declined'
          && request.resource.data.status == 'pending'
          && request.resource.data.initiatedBy == 'user'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'initiatedBy', 'createdAt']));
      allow delete: if (isOrganisation()
          && resource.data.organisationId == request.auth.uid
          && resource.data.status in ['pending', 'accepted'])
        || (signedIn()
          && resource.data.userId == request.auth.uid
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'user'
          && resource.data.status == 'accepted');
    }

    match /organisationGroups/{groupId} {
      allow get, list: if isAdmin() || (isOrganisation() && resource.data.organisationId == request.auth.uid)
        || isAcceptedTeacher(resource.data.organisationId, request.auth.uid);
      allow create: if isOrganisation() && request.resource.data.organisationId == request.auth.uid && request.resource.data.createdBy == request.auth.uid && request.resource.data.name is string && request.resource.data.name.size() > 0;
      allow update: if isOrganisation() && resource.data.organisationId == request.auth.uid && request.resource.data.organisationId == resource.data.organisationId && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if isOrganisation() && resource.data.organisationId == request.auth.uid;

      match /members/{memberId} {
        allow get, list: if isAdmin() || (isOrganisation() && get(/databases/$(database)/documents/organisationGroups/$(groupId)).data.organisationId == request.auth.uid)
          || isAcceptedTeacher(get(/databases/$(database)/documents/organisationGroups/$(groupId)).data.organisationId, request.auth.uid);
        allow create: if isOrganisation() && get(/databases/$(database)/documents/organisationGroups/$(groupId)).data.organisationId == request.auth.uid && request.resource.data.userId == memberId && isAcceptedStudent(request.auth.uid, memberId);
        allow update: if false;
        allow delete: if isOrganisation() && get(/databases/$(database)/documents/organisationGroups/$(groupId)).data.organisationId == request.auth.uid;
      }
    }

    match /tasks/{taskId} {
      allow get, list: if signedIn() && (isAdmin() || canManageTaskData(resource.data)
        || canViewTaskData(resource.data)
        || request.auth.uid in resource.data.assignedUserIds);
      allow create: if false;
      allow update: if signedIn()
        && ((canManageTaskData(resource.data))
          || request.auth.uid in resource.data.assignedUserIds)
        && request.resource.data.organisationId == resource.data.organisationId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.title == resource.data.title
        && request.resource.data.description == resource.data.description
        && request.resource.data.assignedUserIds == resource.data.assignedUserIds
        && request.resource.data.assignedUsers == resource.data.assignedUsers
        && request.resource.data.assignedGroupIds == resource.data.assignedGroupIds
        && request.resource.data.audienceNames == resource.data.audienceNames
        && (((canManageTaskData(resource.data) || request.resource.data.lastStatusUserId == request.auth.uid)
            && (canManageTaskData(resource.data) || taskUserWindowOpen(taskId))
            && request.resource.data.lastStatusUserId in resource.data.assignedUserIds
            && request.resource.data.lastStatusUpdatedBy == request.auth.uid
            && request.resource.data.lastStatus in ['todo', 'in_progress', 'done', 'closed']
            && (request.resource.data.lastStatus != 'closed' || canManageTaskData(resource.data))
            && (request.resource.data.lastStatus != 'done'
              || !('taskType' in resource.data)
              || resource.data.taskType == 'basic'
              || existsAfter(/databases/$(database)/documents/tasks/$(taskId)/submissions/$(request.resource.data.lastStatusUserId)))
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'updatedAt', 'lastStatusAt', 'lastStatus', 'lastStatusUserId', 'lastStatusUserName',
              'lastStatusUpdatedBy', 'lastStatusUpdatedByName'
            ]))
          || (request.resource.data.lastCommentAuthorId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'updatedAt', 'lastCommentAt', 'lastCommentAuthorId', 'lastCommentAuthorName', 'lastCommentPreview'
            ]))
          || (canManageTaskData(resource.data)
            && request.resource.data.isClosed is bool
            && request.resource.data.closedBy == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'isClosed', 'updatedAt', 'closedAt', 'closedBy', 'closedByName'
            ]))
          || (resource.data.sourceType == 'assignment'
            && resource.data.isClosed == false
            && resource.data.endAt is timestamp
            && resource.data.endAt <= request.time
            && request.resource.data.isClosed == true
            && request.resource.data.updatedAt == request.time
            && request.resource.data.closedAt == request.time
            && request.resource.data.closedBy == 'system'
            && request.resource.data.closedByName == 'Deadline'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'isClosed', 'updatedAt', 'closedAt', 'closedBy', 'closedByName'
            ])));
      allow delete: if canManageTaskData(resource.data);

      match /assignees/{assigneeId} {
        allow get: if canAccessTask(taskId)
          && (isAdmin() || canManageTaskData(get(/databases/$(database)/documents/tasks/$(taskId)).data)
            || canViewTaskData(get(/databases/$(database)/documents/tasks/$(taskId)).data)
            || assigneeId == request.auth.uid);
        allow list: if isAdmin() || canManageTaskData(get(/databases/$(database)/documents/tasks/$(taskId)).data)
          || canViewTaskData(get(/databases/$(database)/documents/tasks/$(taskId)).data);
        allow create: if canAccessTask(taskId)
          && (canManageTaskData(get(/databases/$(database)/documents/tasks/$(taskId)).data) || assigneeId == request.auth.uid)
          && (canManageTaskData(get(/databases/$(database)/documents/tasks/$(taskId)).data) || taskUserWindowOpen(taskId))
          && (!('isClosed' in get(/databases/$(database)/documents/tasks/$(taskId)).data)
            || get(/databases/$(database)/documents/tasks/$(taskId)).data.isClosed == false)
          && request.resource.data.userId == assigneeId
          && assigneeId in get(/databases/$(database)/documents/tasks/$(taskId)).data.assignedUserIds
          && request.resource.data.status in ['todo', 'in_progress', 'done']
          && (request.resource.data.status != 'done'
            || !('taskType' in get(/databases/$(database)/documents/tasks/$(taskId)).data)
            || get(/databases/$(database)/documents/tasks/$(taskId)).data.taskType == 'basic'
            || existsAfter(/databases/$(database)/documents/tasks/$(taskId)/submissions/$(assigneeId)));
        allow update: if canAccessTask(taskId)
          && (canManageTaskData(get(/databases/$(database)/documents/tasks/$(taskId)).data) || assigneeId == request.auth.uid)
          && (canManageTaskData(get(/databases/$(database)/documents/tasks/$(taskId)).data) || taskUserWindowOpen(taskId))
          && (!('isClosed' in get(/databases/$(database)/documents/tasks/$(taskId)).data)
            || get(/databases/$(database)/documents/tasks/$(taskId)).data.isClosed == false)
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.userId == assigneeId
          && request.resource.data.status in ['todo', 'in_progress', 'done', 'closed']
          && (resource.data.status != 'closed' || canManageTaskData(get(/databases/$(database)/documents/tasks/$(taskId)).data))
          && (request.resource.data.status != 'closed'
            || (canManageTaskData(get(/databases/$(database)/documents/tasks/$(taskId)).data) && resource.data.status == 'done'))
          && (request.resource.data.status != 'done'
            || !('taskType' in get(/databases/$(database)/documents/tasks/$(taskId)).data)
            || get(/databases/$(database)/documents/tasks/$(taskId)).data.taskType == 'basic'
            || existsAfter(/databases/$(database)/documents/tasks/$(taskId)/submissions/$(assigneeId)))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'updatedAt', 'updatedBy', 'updatedByName', 'userName', 'userEmail'
          ]);
        allow delete: if canManageTaskData(get(/databases/$(database)/documents/tasks/$(taskId)).data);
      }

      match /submissions/{submitterId} {
        allow get: if canAccessTask(taskId)
          && (isAdmin() || canManageTaskData(get(/databases/$(database)/documents/tasks/$(taskId)).data)
            || canViewTaskData(get(/databases/$(database)/documents/tasks/$(taskId)).data)
            || submitterId == request.auth.uid);
        allow list: if isAdmin() || canManageTaskData(get(/databases/$(database)/documents/tasks/$(taskId)).data)
          || canViewTaskData(get(/databases/$(database)/documents/tasks/$(taskId)).data);
        allow create: if signedIn()
          && submitterId == request.auth.uid
          && request.resource.data.userId == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/tasks/$(taskId)).data.assignedUserIds
          && get(/databases/$(database)/documents/tasks/$(taskId)).data.taskType == 'submission'
          && get(/databases/$(database)/documents/tasks/$(taskId)).data.isClosed == false
          && taskUserWindowOpen(taskId)
          && request.resource.data.attachment is map
          && request.resource.data.attachment.path is string
          && request.resource.data.attachment.size is int
          && request.resource.data.attachment.size <= 20 * 1024 * 1024;
        allow update: if false;
        allow delete: if canManageTaskData(get(/databases/$(database)/documents/tasks/$(taskId)).data);
      }

      match /comments/{commentId} {
        allow get, list: if canAccessTask(taskId);
        allow create: if canAccessTask(taskId)
          && (canManageTaskData(get(/databases/$(database)/documents/tasks/$(taskId)).data)
            || request.auth.uid in get(/databases/$(database)/documents/tasks/$(taskId)).data.assignedUserIds)
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.authorRole == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
          && request.resource.data.authorRole in ['user', 'organisation']
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 5000;
        allow update: if false;
        allow delete: if canManageTaskData(get(/databases/$(database)/documents/tasks/$(taskId)).data);
      }
    }

    match /exams/{examId} {
      allow get, list: if isAdmin() || (signedIn() && resource.data.createdBy == request.auth.uid);
      allow create: if canCreateTests() && request.resource.data.createdBy == request.auth.uid && request.resource.data.name is string && request.resource.data.name.size() > 0;
      allow update, delete: if false;
    }

    match /examCatalog/{examId} {
      allow get, list: if signedIn();
      allow create, update, delete: if false;

      match /cycles/{cycleId} {
        allow get, list: if signedIn();
        allow create, update, delete: if false;
      }

      match /updates/{updateId} {
        allow get, list: if signedIn();
        allow create, update, delete: if false;
      }

      match /revisions/{revisionId} {
        allow read, write: if false;
      }
    }

    match /examUpdateReads/{readId} {
      allow get, list: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn()
        && readId == request.auth.uid + '_' + request.resource.data.examId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.examId is string
        && request.resource.data.lastSeenPublishedAt is timestamp;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.examId == resource.data.examId
        && request.resource.data.lastSeenPublishedAt is timestamp;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /examRefreshRuns/{runId} {
      allow read, write: if false;
    }

    match /examRefreshLocks/{examId} {
      allow read, write: if false;
    }

    match /categories/{categoryId} {
      // Organisation-created categories are private to the organisation. The
      // missing-field branch preserves categories created before organisationId
      // was introduced.
      allow get, list: if isAdmin() || (signedIn() && resource.data.createdBy == request.auth.uid
        && (!('organisationId' in resource.data) || resource.data.organisationId == request.auth.uid
          || isAcceptedTeacher(resource.data.organisationId, request.auth.uid)));
      allow create: if canCreateInstituteContent(request.resource.data) && request.resource.data.examId is string && request.resource.data.examId.size() > 0 && request.resource.data.name is string && request.resource.data.name.size() > 0
        && ((isOrganisation() && request.resource.data.organisationId == request.auth.uid)
          || isAcceptedTeacher(request.resource.data.organisationId, request.auth.uid)
          || (isAdmin() && !('organisationId' in request.resource.data)));
      allow update, delete: if false;
    }

    match /questions/{questionId} {
      allow get, list: if canReadQuestion();
      allow create: if canCreateInstituteContent(request.resource.data) && hasNoAnswerKey(request.resource.data) && request.resource.data.visibility in ['public', 'private']
        && ((request.resource.data.visibility == 'public' && canCreateTests())
          || (request.resource.data.visibility == 'private'
            && ((isOrganisation() && request.resource.data.organisationId == request.auth.uid)
              || isAcceptedTeacher(request.resource.data.organisationId, request.auth.uid))));
      allow update: if canManageQuestion() && hasNoAnswerKey(request.resource.data) && request.resource.data.createdBy == resource.data.createdBy && request.resource.data.visibility == resource.data.visibility && request.resource.data.organisationId == resource.data.organisationId;
      allow delete: if false;
    }

    match /questionKeys/{questionId} {
      allow read, write: if false;
    }

    match /testGenerationJobs/{jobId} {
      allow get, list: if isAdmin() || (isOrganisation() && resource.data.ownerId == request.auth.uid);
      allow create, update, delete: if false;

      match /{allPaths=**} {
        allow read: if isAdmin() || (isOrganisation()
          && get(/databases/$(database)/documents/testGenerationJobs/$(jobId)).data.ownerId == request.auth.uid);
        allow write: if false;
      }
    }

    match /tests/{testId} {
      // Collection queries must be authorized from resource.data. Calling
      // get() on the candidate path prevents Firestore from proving that a
      // constrained query can only return allowed documents.
      allow list: if canListTest();
      allow get: if canReadTestById(testId) && canOpenTest(testId);
      allow create: if canCreateInstituteContent(request.resource.data) && !('questions' in request.resource.data) && hasExam(request.resource.data) && hasCategory(request.resource.data) && request.resource.data.published is bool && request.resource.data.deletedAt == null && request.resource.data.visibility in ['public', 'private', 'assigned'] && validTestAccessMode(request.resource.data);
      allow update: if canManageTest(testId) && !('questions' in request.resource.data) && (!('exam' in resource.data) || hasExam(request.resource.data)) && (!('category' in resource.data) || hasCategory(request.resource.data)) && (!('published' in resource.data) || request.resource.data.published is bool) && ((resource.data.deletedAt != null && request.resource.data.deletedAt == null && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletedAt', 'deletedBy'])) || (resource.data.deletedAt == null && request.resource.data.createdBy == resource.data.createdBy && (request.resource.data.deletedAt == null || request.resource.data.deletedBy == request.auth.uid) && request.resource.data.visibility in ['public', 'private', 'assigned'] && validTestAccessMode(request.resource.data)));
      allow delete: if false;

      match /questions/{membershipId} {
        allow read: if canReadTestById(testId) && canOpenTest(testId);
        allow create: if canCreateMembership(testId) && (!('snapshot' in request.resource.data) || hasNoAnswerKey(request.resource.data.snapshot));
        allow update: if canManageTest(testId) && (!('snapshot' in request.resource.data) || hasNoAnswerKey(request.resource.data.snapshot));
        allow delete: if canManageTest(testId);
      }
    }

    match /testAssignments/{assignmentId} {
      allow get, list: if signedIn() && (resource.data.userId == request.auth.uid || resource.data.assignedBy == request.auth.uid || isAdmin());
      allow create: if false;
      allow update: if (canAssignTest(resource.data.testId) && assignmentId == resource.data.assignmentBatchId + '_' + resource.data.userId && request.resource.data.testId == resource.data.testId && request.resource.data.assignmentBatchId == resource.data.assignmentBatchId && request.resource.data.userId == resource.data.userId && request.resource.data.assignedBy == resource.data.assignedBy && request.resource.data.maxAttempts is int && request.resource.data.maxAttempts > 0 && request.resource.data.attemptsUsed is int && request.resource.data.attemptsUsed >= 0 && request.resource.data.startAt is timestamp && request.resource.data.deadline is timestamp && request.resource.data.startAt < request.resource.data.deadline && request.resource.data.endAt == request.resource.data.deadline && request.resource.data.deadline > request.time)
        || (signedIn() && assignmentId == resource.data.assignmentBatchId + '_' + request.auth.uid && resource.data.userId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attemptsUsed']) && request.resource.data.attemptsUsed == resource.data.attemptsUsed + 1 && request.resource.data.attemptsUsed <= resource.data.maxAttempts && resource.data.startAt <= request.time && resource.data.deadline + duration.value(1, 'm') >= request.time);
      allow delete: if canAssignTest(resource.data.testId);
    }

    match /assignmentBatches/{batchId} {
      allow get, list: if signedIn() && (resource.data.assignedBy == request.auth.uid || isAdmin()
        || (isOrganisation() && resource.data.organisationId == request.auth.uid)
        || isAcceptedTeacher(resource.data.organisationId, request.auth.uid));
      allow create: if false;
      allow update, delete: if false;
    }

    match /timetableDrafts/{timetableId} {
      allow get, list: if signedIn() && (isAdmin()
        || (isOrganisation() && resource.data.organisationId == request.auth.uid));
      allow create, update, delete: if false;
    }

    match /timetables/{timetableId} {
      allow get, list: if signedIn() && (isAdmin()
        || (isOrganisation() && resource.data.organisationId == request.auth.uid)
        || (request.auth.uid in resource.data.assignedUserIds
          && isAcceptedStudent(resource.data.organisationId, request.auth.uid))
        || (('teacherUserIds' in resource.data)
          && request.auth.uid in resource.data.teacherUserIds
          && isAcceptedTeacher(resource.data.organisationId, request.auth.uid))
        || isAcceptedTeacher(resource.data.organisationId, request.auth.uid));
      allow create, update, delete: if false;
    }

    match /attendanceSessions/{sessionId} {
      allow read, write: if false;
      match /history/{historyId} {
        allow read, write: if false;
      }
    }

    match /taskEmailJobs/{jobId} {
      allow read, write: if false;
    }

    match /taskEmailDeliveries/{deliveryId} {
      allow read, write: if false;
    }

    match /timetableEmailJobs/{jobId} {
      allow read, write: if false;
    }

    match /timetableEmailDeliveries/{deliveryId} {
      allow read, write: if false;
    }

    match /testAttemptCounters/{counterId} {
      allow get: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if false;
      allow create, update, delete: if false;
    }

    match /submissions/{submissionId} {
      allow get, list: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin()
        || (isOrganisation() && request.auth.uid in resource.data.organisationIds)
        || (('assignmentBatchId' in resource.data)
          && teacherCanViewAssignment(resource.data.assignmentBatchId)));
      allow create, update, delete: if false;
    }

    match /submissionGrading/{submissionId} {
      allow read, write: if false;
    }

    match /organisationSubmissions/{submissionId} {
      allow get, list: if isAdmin() || (isOrganisation() && resource.data.organisationId == request.auth.uid);
      allow create, update, delete: if false;
    }
  }
}
